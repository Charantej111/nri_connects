{
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "editor.quickSuggestions": {
    "strings": true
  },
  "tailwindCSS.experimental.classRegex": [
    "className=\"([^\"]*)",
    "className={`([^`]*)"
  ],
  "tailwindCSS.lint.conflictingClassNames": "ignore",
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
